# ─── Base de datos (Supabase Postgres) ───────────────────────────────────────
# Runtime: connection pooler, puerto 6543. Es el que aguanta las conexiones
# cortas de las funciones serverless de Vercel.
# postgresql://postgres.[ref]:[password]@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true
DATABASE_URL=

# Migraciones: conexion DIRECTA, puerto 5432. PgBouncer no soporta los advisory
# locks de `prisma migrate deploy`, asi que contra el pooler las migraciones
# fallan. Solo la usa Prisma CLI, la web nunca.
# postgresql://postgres.[ref]:[password]@aws-0-eu-central-1.pooler.supabase.com:5432/postgres
DIRECT_URL=

# ─── NextAuth (panel de administracion) ──────────────────────────────────────
NEXTAUTH_SECRET=generate_with_openssl_rand_base64_32
# En produccion tiene que ser la URL real: https://www.rianex.es
NEXTAUTH_URL=http://localhost:3000

ADMIN_EMAIL=admin@tudominio.com
# Generar con: npm run admin:hash -- tu-password-segura
ADMIN_PASSWORD_HASH=

# ─── Limite de peticiones ────────────────────────────────────────────────────
# Sin esto el limitador cae a un contador en memoria que NO limita en Vercel:
# cada instancia serverless tiene el suyo. Vale cualquier Redis de Upstash
# (la integracion de Vercel inyecta estas dos variables sola).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ─── Go High Level ───────────────────────────────────────────────────────────
GHL_API_KEY=your_api_key_here
GHL_LOCATION_ID=your_location_id_here
GHL_PIPELINE_ID=your_pipeline_id_here
GHL_STAGE_NUEVO_LEAD=your_stage_id_here

# Widget de chat. Si se dejan vacias se usan los valores por defecto del codigo.
NEXT_PUBLIC_GHL_WIDGET_ID=
NEXT_PUBLIC_GHL_WIDGET_RESOURCES_URL=

# ─── Analitica y Search Console ──────────────────────────────────────────────
# GA4. Formato G-XXXXXXXXXX. Si se deja vacia, GA4 no se carga.
# Arranca en Consent Mode v2 denegado y solo mide si el visitante acepta.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Search Console, metodo "etiqueta HTML". Solo el valor del content, sin la
# etiqueta meta entera.
GOOGLE_SITE_VERIFICATION=

# ─── Calendario ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_CALENDAR_URL=https://your-calendar-link.com

# ─── Agente de blog (opcional, solo scripts) ─────────────────────────────────
ANTHROPIC_API_KEY=
