generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Runtime: el pooler de Supabase (PgBouncer, puerto 6543). Aguanta las
  // conexiones cortas de las funciones serverless de Vercel.
  url      = env("DATABASE_URL")
  // Migraciones: conexion directa (puerto 5432). PgBouncer en modo transaction
  // no soporta los advisory locks que usa `prisma migrate deploy`, asi que
  // contra el pooler las migraciones fallan.
  directUrl = env("DIRECT_URL")
}

model BlogPost {
  id            String    @id @default(cuid())
  slug          String    @unique
  title         String
  description   String
  content       String    @db.Text
  titleEn       String?
  descriptionEn String?
  contentEn     String?   @db.Text
  tags          String[]
  // Agrupacion tematica. Ordena el enlazado interno y es lo que agrupa el
  // indice de llms.txt: un listado plano de titulos no transmite estructura.
  cluster       String?
  author        String    @default("Ramiro Pérez")
  // Politica de los enlaces externos del articulo: follow, nofollow,
  // sponsored o ugc. Por defecto nofollow, para no repartir autoridad sin
  // haberlo decidido.
  linkPolicy    String    @default("nofollow")
  published     Boolean   @default(false)
  publishedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model LeadSubmission {
  id           String   @id @default(cuid())
  payload      Json
  score        Int
  tier         String
  ghlSynced    Boolean  @default(false)
  ghlContactId String?
  createdAt    DateTime @default(now())

  @@index([tier])
  @@index([createdAt])
}

model Testimonial {
  id        String   @id @default(cuid())
  name      String
  company   String?
  role      String?
  quote     String   @db.Text
  roleEn    String?
  quoteEn   String?  @db.Text
  imageUrl  String?  @db.Text
  approved  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([approved, createdAt])
}

model PageView {
  id        String   @id @default(cuid())
  path      String
  referrer  String?
  sessionId String
  createdAt DateTime @default(now())

  @@index([path, createdAt])
  @@index([sessionId])
  @@index([createdAt])
}
